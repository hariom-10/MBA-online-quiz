rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Question-bank reads are public; all mutations use the Admin API.
    match /examQuestions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    // Imported papers can contain unreviewed content; access them only through the Admin API.
    match /extractedPapers/{paperId} {
      allow read, write: if false;
    }

    // Student records may contain password hashes and are never exposed to client SDKs.
    match /students/{studentId} {
      allow read, write: if false;
    }

    // Category changes are written through the authenticated server API.
    match /examCategories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Platform exam catalog writes are handled by the authenticated server API.
    match /platformExams/{examId} {
      allow read: if true;
      allow write: if false;
    }

    // Platform subject and chapter writes are handled by the authenticated server API.
    match /platformSubjects/{subjectId} {
      allow read: if true;
      allow write: if false;
    }

    match /platformChapters/{chapterId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false; // Deny all other access by default
    }
  }
}
  