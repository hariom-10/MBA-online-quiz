rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Shared exam questions
    match /examQuestions/{questionId} {
      allow read, write: if true;
    }

    // Extracted papers records
    match /extractedPapers/{paperId} {
      allow read, write: if true;
    }

    // Students and other data - restrict access
    match /students/{studentId} {
      allow read: if true; // Or restrict to owner if possible
      allow write: if false; 
    }

    match /{document=**} {
      allow read, write: if false; // Deny all other access by default
    }
  }
}
  